        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu đặt thành công, chỗ của bạn sẽ hiện trên sơ đồ sau vài giây và số dư bị trừ $10. Nếu sơ đồ không thay đổi, nghĩa là chưa có chỗ nào được đặt và bạn không bị trừ tiền."
          }
        }
      }
    },
