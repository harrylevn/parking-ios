          }
        }
      }
    },
    "Signed in as %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng nhập với biển số %@"
          }
        }
      }
    },
    "Someone reached that space first.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có người đặt chỗ đó trước."
          }
        }
      }
    },
    "Someone was faster": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có người nhanh tay hơn"
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi"
          }
        }
      }
    },
    "Something went wrong on the server.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ gặp lỗi."
          }
        }
      }
    },
    "Space %lld is yours": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ %lld là của bạn"
          }
        }
      }
    },
    "Space %lld looks like yours": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ %lld có vẻ là của bạn"
          }
        }
      }
    },
    "Space %lld picked · tap here once open": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chọn chỗ %lld · nhấn khi mở"
          }
        }
      }
    },
    "Space %lld, available": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ %lld, còn trống"
          }
        }
      }
    },
    "Space %lld, reserved by you": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ %lld, bạn đã đặt"
          }
        }
      }
    },
    "Space %lld, selected": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ %lld, đang chọn"
          }
        }
      }
    },
    "Space %lld, taken": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ %lld, đã có người đặt"
          }
        }
      }
    },
    "Space %lld, taken by plate ending %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Space %1$lld, taken by plate ending %2$@"
          }
        },
        "vi": {
