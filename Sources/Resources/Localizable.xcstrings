    "Still checking": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra"
          }
        }
      }
    },
    "Taken": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đặt"
          }
        }
      }
    },
    "Ten seconds until reservations open.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn mười giây nữa là mở đặt chỗ."
          }
        }
      }
    },
    "That plate already has an account. Sign in instead.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biển số này đã có tài khoản. Hãy đăng nhập."
          }
        }
      }
    },
    "That request wasn't valid.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu không hợp lệ."
          }
        }
      }
    },
    "That space went to another driver. Nothing was charged.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ đó đã thuộc về người khác. Bạn không bị trừ tiền."
          }
        }
      }
    },
    "The button turns on when reservations open. Nothing is sent before you tap it.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nút sẽ bật khi mở đặt chỗ. Không có gì được gửi đi trước khi bạn nhấn."
          }
        }
      }
    },
    "The connection dropped before the reply came back.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối bị ngắt trước khi nhận được phản hồi."
          }
        }
      }
    },
    "The connection dropped before we heard back.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối bị ngắt trước khi nhận được phản hồi."
          }
        }
      }
    },
    "The lot has no spaces for tomorrow.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bãi xe không có chỗ nào cho ngày mai."
          }
        }
      }
    },
    "The request timed out before we heard back.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu đã hết thời gian chờ trước khi nhận được phản hồi."
          }
        }
      }
    },
    "The server says reservations aren't open yet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ báo chưa mở đặt chỗ"
          }
        }
      }
    },
    "The server sent something we couldn't read.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ gửi về dữ liệu không đọc được."
          }
        }
      }
    },
    "The server was busy": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ đang quá tải"
          }
        }
      }
    },
    "The server was busy. Try again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ đang quá tải. Hãy thử lại."
          }
        }
      }
    },
    "The server's identity couldn't be verified, so nothing was sent. Try again on a network you trust.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác minh được danh tính máy chủ nên chưa có gì được gửi đi. Hãy thử lại trên mạng mà bạn tin cậy."
          }
        }
      }
    },
    "This app's opening time doesn't match the server's, so it can't show a countdown.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ mở đặt chỗ của ứng dụng không khớp với máy chủ nên không thể hiện đồng hồ đếm ngược."
          }
        }
      }
    },
    "This vehicle already holds a space for tomorrow.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xe này đã có chỗ cho ngày mai."
          }
        }
      }
    },
    "Tomorrow": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày mai"
          }
        }
      }
    },
    "Tomorrow is full": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày mai đã hết chỗ"
          }
        }
      }
    },
    "Too many people arrived at once and your turn timed out. Nothing was charged.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá nhiều người đặt cùng lúc nên lượt của bạn đã hết thời gian chờ. Bạn không bị trừ tiền."
          }
        }
      }
    },
    "Total": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại"
          }
        }
      }
    },
    "Two spaces show a plate ending in %@, so we can't tell you which one is yours — or whether either of them is.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có hai chỗ hiện biển số đuôi %@, nên chúng tôi không thể biết chỗ nào là của bạn, hoặc liệu có chỗ nào là của bạn không."
          }
        }
      }
    },
    "Uppercase letters, numbers and hyphens (e.g. ABC-1234).": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ in hoa, chữ số và dấu gạch ngang (ví dụ ABC-1234)."
          }
        }
      }
    },
    "Waiting for the server to answer. Nothing more is sent while this runs.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ máy chủ phản hồi. Không gửi thêm yêu cầu nào trong lúc này."
          }
        }
      }
    },
    "Watch the board": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi sơ đồ"
          }
        }
      }
    },
    "We take the first free space. Balance after, %@.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống lấy chỗ trống đầu tiên. Số dư sau khi đặt: %@."
          }
        }
      }
    },
    "You already have a space": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã có chỗ"
          }
        }
      }
    },
    "You didn't confirm it was you, so nothing was sent and nothing was charged.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa xác nhận danh tính nên không có gì được gửi đi và bạn không bị trừ tiền."
          }
        }
      }
    },
    "You were number %lld in the queue": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đứng thứ %lld trong hàng chờ"
          }
        }
      }
    },
    "You were number %lld in the queue · settled in %lld ms": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You were number %1$lld in the queue · settled in %2$lld ms"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đứng thứ %1$lld trong hàng chờ · xử lý trong %2$lld ms"
          }
        }
      }
    },
    "Your attempt is still being processed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu của bạn vẫn đang được xử lý."
          }
        }
      }
    },
    "Your balance above has been refreshed, so it shows whether the $10 was taken.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư phía trên đã được cập nhật, nên bạn có thể thấy $10 đã bị trừ hay chưa."
          }
        }
      }
    },
    "Your balance above has been refreshed, so it shows whether the $10 was taken. The board keeps updating.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư phía trên đã được cập nhật, nên bạn có thể thấy $10 đã bị trừ hay chưa. Sơ đồ vẫn tiếp tục cập nhật."
          }
        }
      }
    },
    "Your connection or the server may be down. Retrying every few seconds; the board stays hidden rather than showing spaces that might be wrong.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối của bạn hoặc máy chủ có thể đang gặp sự cố. Ứng dụng thử lại sau vài giây; sơ đồ được ẩn đi thay vì hiện các chỗ có thể không đúng."
          }
        }
      }
    },
    "Your device clock is over 30 seconds off the server. The countdown follows the server.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng hồ thiết bị lệch hơn 30 giây so với máy chủ. Đồng hồ đếm ngược chạy theo giờ máy chủ."
          }
        }
      }
    },
    "Your request was sent, but the reply didn't arrive in time.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu đã được gửi, nhưng phản hồi không đến kịp."
          }
        }
      }
    },
    "Your session expired. Please sign in again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại."
          }
        }
      }
    },
    "Yours": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Của bạn"
          }
        }
      }
    },
